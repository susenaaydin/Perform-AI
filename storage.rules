rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read-only access to triad images
    match /triads_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Match all files in the 'users/{userId}' directory
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
