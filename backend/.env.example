# ==============================================================================
# PerformAI Backend Environment Variables
# ==============================================================================

# Google Gemini API Key (Required for LLM Dramaturgical Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Credentials (Optional if placed at backend/config/serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=backend/config/serviceAccountKey.json

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Torch / Model Acceleration
# Set HF_SKIP_TORCH_LOAD_SAFETY_CHECK=1 for trusted weights
HF_SKIP_TORCH_LOAD_SAFETY_CHECK=1
HF_TRUST_ANONYMOUS_CODE=1
TRANSFORMERS_VERIFY_SCHEDULES=0
